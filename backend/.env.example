SECRET_KEY=your-super-secret-django-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL - replace with your actual Supabase project values
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# OR use individual settings if not using DATABASE_URL
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=db.your-project.supabase.co
# DB_PORT=5432

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# For local SQLite development (set DATABASE_URL to empty and this to true)
USE_SQLITE=True
